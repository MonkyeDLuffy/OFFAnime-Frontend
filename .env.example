# OffAnime frontend — server-side environment variables (backend.md §5, §10).
# Copy to .env.local for local development. These are NEVER exposed to the
# browser; do not create NEXT_PUBLIC_ variants of them.

# Base URL of the OffAnime backend (e.g. http://localhost:8080 or the
# deployed Vercel/Cloudflare URL).
OFFANIME_BACKEND_URL=

# The backend's BACKEND_API_SECRET value. The frontend proxy injects it as
# `x-api-key` / Bearer auth for every protected /api/* call.
BACKEND_API_SECRET=
